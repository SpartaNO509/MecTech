<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof titulo !== 'undefined' ? titulo + ' | ' : '' %>MecTech</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="/css/style.css" rel="stylesheet">
</head>
<body>

<% const ativo = typeof pagina !== 'undefined' ? pagina : ''; %>
<nav class="navbar navbar-expand-lg navbar-dark navbar-mectech sticky-top">
    <div class="container">
        <a class="navbar-brand" href="/"> Mec<span>Tech</span></a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="menu">
            <ul class="navbar-nav me-auto">
                <li class="nav-item"><a class="nav-link <%= ativo === 'home' ? 'active' : '' %>" href="/">Início</a></li>
                <li class="nav-item"><a class="nav-link <%= ativo === 'produtos' ? 'active' : '' %>" href="/produtos">Produtos</a></li>
                <li class="nav-item"><a class="nav-link <%= ativo === 'sobre' ? 'active' : '' %>" href="/sobre">Sobre</a></li>
            </ul>
            <div class="d-flex align-items-center gap-2">
                <% if (usuario) { %>
                    <% if (usuario.nivel_acesso === 'admin') { %>
                        <a class="btn btn-sm btn-warning" href="/admin/produtos">Painel Admin</a>
                    <% } %>
                    <span class="text-light small">Olá, <%= usuario.nome %></span>
                    <a class="btn btn-sm btn-outline-light" href="/logout">Sair</a>
                <% } else { %>
                    <a class="btn btn-sm btn-mectech" href="/login">Entrar</a>
                <% } %>
            </div>
        </div>
    </div>
</nav>