<%- include('partials/header', { titulo: 'Produtos', pagina: 'produtos' }) %>

<main class="container mt-4">
    <h1 class="section-title mb-4">Produtos</h1>

    <form class="row g-2 mb-4" method="GET" action="/produtos">
        <div class="col-md-6">
            <input type="text" name="busca" class="form-control" placeholder="Buscar por nome ou descrição..." value="<%= busca %>">
        </div>
        <div class="col-md-3">
            <select name="marca" class="form-select">
                <option value="">Todas as marcas</option>
                <% marcas.forEach(m => { %>
                    <option value="<%= m.marca %>" <%= m.marca === marca ? 'selected' : '' %>><%= m.marca %></option>
                <% }) %>
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button class="btn btn-mectech flex-fill" type="submit">Filtrar</button>
            <a href="/produtos" class="btn btn-outline-secondary">Limpar</a>
        </div>
    </form>

    <% if (produtos.length === 0) { %>
        <div class="alert alert-warning">Nenhum produto encontrado.</div>
    <% } else { %>
        <p class="text-muted"><%= produtos.length %> produto(s) encontrado(s)</p>
        <div class="row g-4">
            <% produtos.forEach(p => { %>
                <div class="col-sm-6 col-lg-4"><%- include('partials/card-produto', { p }) %></div>
            <% }) %>
        </div>
    <% } %>
</main>

<%- include('partials/footer') %>
